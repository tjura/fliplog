# `make up` creates a private .env with a random BETTER_AUTH_SECRET; do not
# commit or share it. Override local ports in the shell so Make and Compose
# agree, for example: APP_PORT=3197 PREVIEW_PORT=3198 make up
# Production needs its own secret and HTTPS base URL; see docs/development.md.
APP_PORT=3187
PREVIEW_PORT=3188
